{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "quizmatter-v1",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-01",
  // nodejs_compat is needed by Next's server code, including proxy.ts (always runs on Node).
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // Cloudflare creates the DNS record and HTTPS certificate for this domain on deploy.
  "routes": [{ "pattern": "quizmatter.com", "custom_domain": true }],
  // Short-lived drafts that Claude sends through the MCP server (/api/mcp), picked up in the editor.
  "d1_databases": [
    {
      "binding": "DRAFTS_DB",
      "database_name": "quizmatter-drafts",
      "database_id": "7873e00d-72bd-4d7d-acaf-cc3f74f8e467",
      "migrations_dir": "d1/migrations"
    }
  ],
  "observability": { "enabled": true }
}
