{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "quizmatter-v1",
  // Wraps the app (.open-next/worker.js) to also run the weekly photo cleanup (see "triggers" below).
  "main": "worker.ts",
  "compatibility_date": "2026-09-01",
  // nodejs_compat is needed by Next's server code, including proxy.ts (always runs on Node).
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // Cloudflare creates the DNS record and HTTPS certificate for this domain on deploy.
  "routes": [{ "pattern": "quizmatter.com", "custom_domain": true }],
  // Short-lived drafts that Claude sends through the MCP server (/api/mcp), picked up in the editor.
  // "remote": local dev (next dev) uses this live database too, so it sees the drafts Claude sent.
  "d1_databases": [
    {
      "binding": "DRAFTS_DB",
      "database_name": "quizmatter-drafts",
      "database_id": "7873e00d-72bd-4d7d-acaf-cc3f74f8e467",
      "migrations_dir": "d1/migrations",
      "remote": true
    }
  ],
  // Photos teachers upload (or add from a link), served to everyone from images.quizmatter.com.
  // "remote": local dev uses this live bucket too, like the drafts database above.
  "r2_buckets": [{ "binding": "PHOTOS_BUCKET", "bucket_name": "quizmatter-images", "remote": true }],
  // Every Sunday at 3:00 AM (UTC), delete photo files nothing uses anymore (see docs/photo-cleanup.md).
  // It also needs the secret SUPABASE_SECRET_KEY, added in the Cloudflare dashboard.
  // If you change the time, change nextCleanupRun() in src/lib/cleanupPhotos.ts too (the admin page shows it).
  // Every day at 4:00 AM (UTC), delete accounts whose email wasn't confirmed within 3 days (src/lib/cleanupAccounts.ts).
  // Both times are also in worker.ts, which picks the job by its time.
  "triggers": { "crons": ["0 3 * * SUN", "0 4 * * *"] },
  // For the photo cleanup. Not secret: the browser already knows it.
  "vars": { "SUPABASE_URL": "https://zmmkqncfbjkmwfyngaha.supabase.co" },
  "observability": { "enabled": true }
}
